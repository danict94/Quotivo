{
    "expo":  {
                 "version":  "0.1.11",
                 "orientation":  "portrait",
                 "userInterfaceStyle":  "automatic",
                 "icon":  "./asset/icon.png",
                 "assetBundlePatterns":  [
                                             "**/*"
                                         ],
                 "ios":  {
                             "supportsTablet":  true
                         },
                 "android":  {
                                 "versionCode":  12,
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./asset/adaptive-icon.png",
                                                      "backgroundColor":  "#FFFFFF",
                                                      "monochromeImage":  "./asset/monochrome-icon.png"
                                                  },
                                 "blockedPermissions":  [
                                                            "android.permission.READ_EXTERNAL_STORAGE",
                                                            "android.permission.WRITE_EXTERNAL_STORAGE"
                                                        ]
                             },
                 "plugins":  [
                                 "expo-status-bar",
                                 "expo-sqlite",
                                 "@config-plugins/react-native-pdf",
                                 "@config-plugins/react-native-blob-util",
                                 "./plugins/withShortCmakeStaging",
                                 "expo-sharing",
                                 [
                                     "expo-splash-screen",
                                     {
                                         "image":  "./asset/splash-icon.png",
                                         "resizeMode":  "contain",
                                         "backgroundColor":  "#FFFFFF",
                                         "dark":  {
                                                      "image":  "./asset/splash-icon.png",
                                                      "backgroundColor":  "#0F1210"
                                                  }
                                     }
                                 ],
                                 "./plugins/withQuotivoSvgAssets",
                                 "expo-web-browser",
                                 "expo-secure-store"
                             ]
             }
}
