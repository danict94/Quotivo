{
  "name": "quotivo-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "set APP_VARIANT=stable&& expo start",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-variant.ps1 -Variant stable -BuildType debug -Install",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1",
    "android:release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-release.ps1 -CheckOnly",
    "android:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-update.ps1",
    "android:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-variant.ps1 -Variant dev -BuildType debug -Install",
    "android:dev:standalone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-variant.ps1 -Variant dev -BuildType release -Install",
    "start:dev": "set APP_VARIANT=dev&& npx expo start --dev-client --scheme exp+quotivo-dev",
    "code:lines": "node scripts/check-code-lines.cjs",
    "code:duplicates": "jscpd --config .jscpd.json",
    "code:cycles": "depcruise --config .dependency-cruiser.cjs src App.tsx",
    "code:dead": "knip --no-progress",
    "code:guard": "node scripts/code-guard.cjs"
  },
  "dependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "docx": "^9.7.1",
    "expo": "^57.0.22",
    "expo-asset": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.10",
    "expo-print": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.11",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.10",
    "@types/sql.js": "^1.4.11",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "^5.4.1",
    "jszip": "^3.10.2",
    "knip": "^6.41.0",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  }
}
